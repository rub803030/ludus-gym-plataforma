{
  "name": "ludus-gym-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=20.11.0" },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @ludus/api db:generate",
    "db:migrate": "pnpm --filter @ludus/api db:migrate",
    "owner:create": "node scripts/create-owner.mjs",
    "commit": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/git-commit.ps1",
    "verify:flows": "python scripts/test-api-flows.py",
    "verify:all": "python scripts/verify-all.py"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}