# Variables compartidas por API y Web. Copia a .env.local y rellena.
# En producción estos valores se configuran en Vercel/Fly, nunca en el repo.

NODE_ENV=development
API_PORT=4000
WEB_PORT=3000

# Base de datos Supabase: pooler (6543) para DATABASE_URL, directa (5432) para DIRECT_URL.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:CHANGE_ME@localhost:5432/postgres?sslmode=require

# Redis compartido. Obligatorio en producción (Upstash, Redis Cloud, etc.).
REDIS_URL=redis://localhost:6379

# Secretos: 32 bytes aleatorios cada uno; FIELD_ENCRYPTION_KEY lleva prefijo base64:.
JWT_ACCESS_SECRET=replace-with-32-byte-random-secret
JWT_REFRESH_SECRET=replace-with-different-32-byte-secret
QR_HMAC_SECRET=replace-with-32-byte-qr-secret
FIELD_ENCRYPTION_KEY=base64:32-byte-key-for-aes-256-gcm
CSRF_SECRET=replace-with-32-byte-csrf-secret

# Origen HTTPS exacto de la web (Vercel). La API lo valida al arrancar.
CORS_ORIGIN=http://localhost:3000

# Almacenamiento S3/R2. Los valores minioadmin solo sirven en desarrollo.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ludus-gym
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
RATE_LIMIT_MAX=120

# WEB: el navegador llama a /api/* en el mismo origen; dejar vacío.
NEXT_PUBLIC_API_URL=
# WEB (solo servidor): a dónde Next.js redirige /api/*. En producción, la URL de Fly.io.
API_UPSTREAM_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=Ludus GYM
