# Variables compartidas por API y Web. Copia a .env.local y rellena.
# En producción estos valores se configuran en Vercel/Fly, nunca en el repo.

NODE_ENV=development
API_PORT=4000
WEB_PORT=3000

# Base de datos Supabase: pooler (6543) para DATABASE_URL, directa (5432) para DIRECT_URL.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:CHANGE_ME@localhost:5432/postgres?sslmode=require

# Redis opcional para rate limit distribuido. Vacío = store local (1 sola instancia).
# Para producción multi-instancia usa Upstash/Redis Cloud y nunca localhost.
REDIS_URL=redis://localhost:6379

# Secretos: 32 bytes aleatorios cada uno; FIELD_ENCRYPTION_KEY lleva prefijo base64:.
JWT_ACCESS_SECRET=replace-with-32-byte-random-secret
JWT_REFRESH_SECRET=replace-with-different-32-byte-secret
QR_HMAC_SECRET=replace-with-32-byte-qr-secret
FIELD_ENCRYPTION_KEY=base64:32-byte-key-for-aes-256-gcm
CSRF_SECRET=replace-with-32-byte-csrf-secret

# Correo transaccional. Opción recomendada: SMTP propio, entrega directa al socio
# sin dominio verificado. EMAIL_FROM debe usar la MISMA dirección que SMTP_USER
# cuando se usa una sola cuenta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-cuenta@gmail.com
SMTP_PASSWORD=contraseña-de-aplicacion
EMAIL_FROM=Ludus GYM <tu-cuenta@gmail.com>
# Rotación opcional de hasta 10 cuentas (un solo secreto JSON en Fly).
# El remitente se deriva de cada user si no se indica "from".
# SMTP_DAILY_LIMIT es el cupo por cuenta y día (300 por defecto).
SMTP_ACCOUNTS=[{"user":"cuenta1@gmail.com","password":"app-password-1"},{"user":"cuenta2@gmail.com","password":"app-password-2"}]
SMTP_DAILY_LIMIT=300
# Alternativa sin SMTP: Resend. En modo test, onboarding@resend.dev solo entrega
# a la dirección propietaria de la cuenta de Resend.
RESEND_API_KEY=re_replace_with_resend_key
# Bandeja del dueño de Resend, único destino permitido por onboarding@resend.dev.
# Se ignora por completo cuando hay SMTP configurado o un remitente verificado.
RESEND_TEST_RECIPIENT=tu-correo-dueno@gmail.com
WEB_APP_URL=https://ludus-gym-plataforma.vercel.app
EMAIL_VERIFICATION_TTL_MINUTES=30

# Origen HTTPS exacto de la web (Vercel). La API lo valida al arrancar.
CORS_ORIGIN=http://localhost:3000

# Almacenamiento S3/R2. Los valores minioadmin solo sirven en desarrollo.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ludus-gym
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
RATE_LIMIT_MAX=120

# WEB: el navegador llama a /api/* en el mismo origen; dejar vacío.
NEXT_PUBLIC_API_URL=
# WEB (solo servidor): a dónde Next.js redirige /api/*. En producción, la URL de Fly.io.
API_UPSTREAM_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=Ludus GYM
